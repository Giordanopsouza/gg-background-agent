flowchart TB
    subgraph Frontend["🖥️ Frontend (React App)"]
        UI["Session UI<br/>(SessionEditorPage)"]
        RQ["React Query<br/>Cache"]
        WS_Client["WebSocket<br/>Subscriptions"]
        Iframe_VSCode["VSCode iFrame"]
        Iframe_VNC["VNC iFrame"]
        Iframe_TTYD["Terminal iFrame"]
    end

    subgraph CloudflareWorker["☁️ Cloudflare Worker (agent-api)"]
        direction TB
        API["REST API Routes<br/>(/api/sessions/*)"]
        
        subgraph DurableObjects["Durable Objects"]
            SessionAgent["SessionAgent DO<br/>• Per-session state<br/>• Messages & Parts<br/>• Question handling<br/>• Durable SQLite"]
            EventBus["EventBus DO<br/>• Real-time broadcasting<br/>• User-tagged connections<br/>• Notifications"]
        end
        
        D1[("D1 Database<br/>• Session metadata<br/>• Users & Auth<br/>• Integrations<br/>• Agent memories")]
        
        R2[("R2 Storage<br/>• Screenshots<br/>• File uploads<br/>• Assets")]
    end

    subgraph ModalBackend["🐍 Modal Backend (Python)"]
        direction TB
        SessionMgr["Session Manager<br/>(session.py)"]
        SandboxMgr["Sandbox Manager<br/>(sandboxes.py)"]
        
        subgraph ImageConfigs["📦 Image Definitions<br/>(backend/images/)"]
            BaseImage["base.py<br/>• Common tools<br/>• Code-server<br/>• TTYD<br/>• Claude CLI"]
            WebAppImage["webapp.py<br/>• Dev server config<br/>• Deploy settings"]
            CoreImage["core.py<br/>• Postgres, Redis<br/>• Temporal, RabbitMQ"]
            OtherImages["android.py, ios.py,<br/>elixir.py, etc."]
        end
        
        ModalDict[("Modal Dict<br/>• Session locks<br/>• Image store")]
        ModalQueue[/"Modal Queue<br/>• Prompt queue"/]
    end

    subgraph ModalSandbox["📦 Modal Sandbox (Container)"]
        direction TB
        
        subgraph Runner["🏃 Runner (Bun/TypeScript)"]
            RunnerCLI["Runner CLI<br/>(bin.ts)"]
            PromptHandler["Prompt Handler<br/>(prompt.ts)"]
            AgentClientWS["AgentClient<br/>(WebSocket to DO)"]
            ProxyFactory["Proxy Factory<br/>• JWT Auth<br/>• WS Proxying"]
        end
        
        subgraph OpenCode["🤖 OpenCode Server"]
            OC_Server["opencode serve"]
            OC_SDK["@opencode-ai/sdk"]
            OC_Events["Event Stream<br/>• message.*<br/>• session.*<br/>• question.*"]
        end
        
        subgraph VSCodeStack["💻 VS Code Server"]
            CodeServer["code-server"]
            VSProxy["Auth Proxy"]
        end
        
        subgraph VNCStack["🖼️ VNC Stack"]
            Xvfb["Xvfb<br/>Virtual Display"]
            Fluxbox["Fluxbox<br/>Window Manager"]
            X11VNC["x11vnc"]
            Websockify["websockify"]
            VNCProxy["Auth Proxy"]
            Chrome["Chromium<br/>+ DevTools"]
            DevServer["Dev Server<br/>(repo-specific)"]
        end
        
        subgraph TTYDStack["⌨️ Web Terminal"]
            TTYD["ttyd"]
            TTYDProxy["Auth Proxy"]
        end
        
        RepoCode[("Repository Code")]
        RunnerVol[("Runner Volume")]
    end

    subgraph ExternalServices["🌐 External Services"]
        GitHub["GitHub API"]
        Slack["Slack API"]
        Linear["Linear API"]
        Anthropic["Anthropic<br/>(Claude)"]
        OpenAI["OpenAI<br/>(GPT)"]
        Google["Google<br/>(Gemini)"]
    end

    %% Frontend to Worker connections
    UI -->|"HTTP REST"| API
    UI -->|"Prompt submission"| API
    WS_Client <-->|"WebSocket"| EventBus
    WS_Client <-->|"WebSocket"| SessionAgent
    RQ <-->|"Cache updates"| WS_Client

    %% iFrames through Modal Tunnels
    Iframe_VSCode <-->|"Modal Tunnel<br/>+ JWT Auth"| VSProxy
    Iframe_VNC <-->|"Modal Tunnel<br/>+ JWT Auth"| VNCProxy
    Iframe_TTYD <-->|"Modal Tunnel<br/>+ JWT Auth"| TTYDProxy

    %% Worker internal connections
    API --> SessionAgent
    API --> D1
    API --> R2
    SessionAgent --> EventBus
    SessionAgent --> D1
    EventBus --> D1

    %% Worker to Modal Backend
    API -->|"HTTP/gRPC<br/>spawn sandbox"| SessionMgr
    SessionMgr --> SandboxMgr
    SandboxMgr --> ImageConfigs
    SandboxMgr -->|"Create from<br/>image snapshot"| ModalSandbox
    SandboxMgr <--> ModalDict
    SessionMgr <--> ModalQueue

    %% Runner connections
    PromptHandler <-->|"WebSocket<br/>(AgentClient)"| SessionAgent
    AgentClientWS -->|"opencode events<br/>via WS"| SessionAgent
    PromptHandler -->|"HTTP webhook<br/>server events"| API
    RunnerCLI --> PromptHandler

    %% Runner to OpenCode
    PromptHandler <-->|"HTTP API"| OC_Server
    OC_Server --> OC_SDK
    OC_Events -->|"Event stream"| PromptHandler

    %% Proxy connections
    ProxyFactory --> VSProxy
    ProxyFactory --> VNCProxy
    ProxyFactory --> TTYDProxy
    VSProxy --> CodeServer
    VNCProxy --> Websockify
    TTYDProxy --> TTYD

    %% VNC internal
    Xvfb --> X11VNC
    Fluxbox --> Xvfb
    X11VNC --> Websockify
    Chrome --> Xvfb
    DevServer -->|"Dev URL"| Chrome

    %% External connections - LLM Providers (at bottom)
    OC_SDK <-->|"API"| Anthropic
    OC_SDK <-->|"API"| OpenAI
    OC_SDK <-->|"API"| Google
    API <--> GitHub
    EventBus --> Slack
    API <--> Linear

    %% Volume/Code connections
    OC_Server -->|"Read/Write"| RepoCode
    CodeServer -->|"Edit"| RepoCode
    RunnerCLI -->|"Config"| RunnerVol

